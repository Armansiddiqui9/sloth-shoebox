# Copy to .env and edit. Every variable is optional.
SLOTH_HOST=127.0.0.1
SLOTH_PORT=8337
# Where the ledger lives. Delete this one file to erase everything.
SLOTH_DB=data/sloth_shoebox.db
# 1 = seed the demo ledger on first run when the database is empty.
SLOTH_AUTOSEED=1

# Local model runtime (Ollama). The app works without it.
SLOTH_OLLAMA_URL=http://127.0.0.1:11434
SLOTH_TEXT_MODEL=phi4-mini
SLOTH_VLM_MODEL=gemma4:12b
# demo   = unknown uploads get a deterministic stand-in parse
# ollama = unknown uploads go to SLOTH_VLM_MODEL
SLOTH_PARSER=demo
